# Sanad Islamic Application Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
SANAD_DATABASE_URL=postgresql://sanad_user:sanad_password@localhost:5432/sanad

# Redis Configuration
SANAD_REDIS_URL=redis://localhost:6379

# Qdrant Vector Database Configuration
SANAD_QDRANT_URL=http://localhost:6333
SANAD_QDRANT_API_KEY=

# Server Configuration
SANAD_SERVER_HOST=0.0.0.0
SANAD_SERVER_PORT=8080
SANAD_SERVER_REQUEST_TIMEOUT_SECONDS=30

# Security Configuration
SANAD_SECURITY_JWT_SECRET=your-super-secret-jwt-key-change-in-production-make-it-long-and-random
SANAD_SECURITY_JWT_EXPIRATION_HOURS=24
SANAD_SECURITY_PASSWORD_SALT_ROUNDS=12
SANAD_SECURITY_RATE_LIMIT_REQUESTS_PER_MINUTE=60
SANAD_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# External APIs Configuration
SANAD_EXTERNAL_APIS_HUGGING_FACE_API_KEY=your-hugging-face-api-key
SANAD_EXTERNAL_APIS_HUGGING_FACE_BASE_URL=https://api-inference.huggingface.co
SANAD_EXTERNAL_APIS_HUGGING_FACE_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SANAD_EXTERNAL_APIS_HUGGING_FACE_TIMEOUT_SECONDS=30
SANAD_EXTERNAL_APIS_HUGGING_FACE_MAX_RETRIES=3

SANAD_EXTERNAL_APIS_GEO_LOCATION_API_KEY=your-geo-location-api-key
SANAD_EXTERNAL_APIS_GEO_LOCATION_BASE_URL=https://api.ipgeolocation.io
SANAD_EXTERNAL_APIS_GEO_LOCATION_TIMEOUT_SECONDS=10

SANAD_EXTERNAL_APIS_EMBEDDING_SERVICE_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SANAD_EXTERNAL_APIS_EMBEDDING_SERVICE_API_URL=https://api-inference.huggingface.co
SANAD_EXTERNAL_APIS_EMBEDDING_SERVICE_API_KEY=your-embedding-service-api-key
SANAD_EXTERNAL_APIS_EMBEDDING_SERVICE_BATCH_SIZE=32
SANAD_EXTERNAL_APIS_EMBEDDING_SERVICE_TIMEOUT_SECONDS=30

# Logging Configuration
SANAD_LOGGING_LEVEL=info
SANAD_LOGGING_FORMAT=json
SANAD_LOGGING_FILE_PATH=
SANAD_LOGGING_MAX_FILE_SIZE_MB=100
SANAD_LOGGING_MAX_FILES=10

# Development/Production Environment
RUST_ENV=development
RUST_LOG=info