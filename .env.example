# API Integration Service - Environment Variables Template
# Copy this file to .env and fill in your actual API keys and configuration

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================
# These override the values in config/api_integration_config.yaml

# Service name (default: api-integration-service)
SERVICE_NAME=api-integration-service

# Service port (default: 8080)
SERVICE_PORT=8080

# Service host (default: 0.0.0.0)
SERVICE_HOST=0.0.0.0

# Configuration file path (optional, defaults to config/api_integration_config.yaml)
# CONFIG_PATH=/path/to/custom/config.yaml

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis is used for caching and rate limiting

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Redis connection pool size (default: 10)
REDIS_POOL_SIZE=10

# Redis connection timeout (default: 5s)
REDIS_CONNECTION_TIMEOUT=5s

# =============================================================================
# POSTGRESQL CONFIGURATION
# =============================================================================
# PostgreSQL is used for persistent storage

# PostgreSQL connection URL (can also use DATABASE_URL)
POSTGRES_URL=postgresql://user:password@localhost:5432/sanad

# Alternative: DATABASE_URL (takes precedence over POSTGRES_URL if set)
# DATABASE_URL=postgresql://user:password@localhost:5432/sanad

# PostgreSQL connection pool size (default: 20)
POSTGRES_POOL_SIZE=20

# PostgreSQL connection timeout (default: 10s)
POSTGRES_CONNECTION_TIMEOUT=10s

# =============================================================================
# API KEYS - QURAN APIS
# =============================================================================
# Most Quran APIs don't require keys, but some may have optional authentication

# Quran.com API Key (optional - for higher rate limits)
# Get your key at: https://quran.com/api
QURAN_COM_API_KEY=

# IslamHouse QuranEnc API Key (optional)
# Get your key at: https://islamhouse.com/
ISLAMHOUSE_API_KEY=

# =============================================================================
# API KEYS - HADITH APIS
# =============================================================================

# Sunnah.com API Key (REQUIRED for hadith access)
# Get your key at: https://sunnah.com/
# This is the primary hadith source with authenticated chains
SUNNAH_COM_API_KEY=your_sunnah_com_api_key_here

# =============================================================================
# API KEYS - PRAYER TIMES & QIBLA APIS
# =============================================================================

# Aladhan API (no key required - free and open)
# Documentation: https://aladhan.com/prayer-times-api

# Islamic Finder API Key (optional - for backup)
# Get your key at: https://www.islamicfinder.org/
ISLAMIC_FINDER_API_KEY=

# =============================================================================
# API KEYS - AI/NLP APIS
# =============================================================================
# AI services are used ONLY for technical language processing (search, embeddings)
# NOT for generating Islamic rulings or fatwas

# Hugging Face API Key (REQUIRED for AI features)
# Get your key at: https://huggingface.co/settings/tokens
# Used for Arabic NLP models and semantic search
HUGGING_FACE_API_KEY=your_huggingface_api_key_here

# OpenAI API Key (OPTIONAL - alternative AI provider)
# Get your key at: https://platform.openai.com/api-keys
# Only used if Hugging Face is unavailable
OPENAI_API_KEY=

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level: trace, debug, info, warn, error (default: info)
LOG_LEVEL=info

# Environment: development, staging, production (default: development)
ENVIRONMENT=development

# Enable structured JSON logging (default: false)
JSON_LOGGING=false

# =============================================================================
# OBSERVABILITY (OPTIONAL)
# =============================================================================

# Prometheus metrics endpoint (default: /metrics)
METRICS_ENDPOINT=/metrics

# OpenTelemetry collector endpoint (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =============================================================================
# SECURITY
# =============================================================================

# Enable API key rotation without restart (default: true)
ENABLE_HOT_RELOAD=true

# API key rotation check interval (default: 5m)
KEY_ROTATION_CHECK_INTERVAL=5m

# =============================================================================
# RATE LIMITING (OPTIONAL OVERRIDES)
# =============================================================================
# These override the rate limits in the YAML config
# Format: API_NAME_RATE_LIMIT_PER_MINUTE, PER_HOUR, PER_DAY

# Example: Override Quran.com rate limits
# QURAN_COM_RATE_LIMIT_PER_MINUTE=100
# QURAN_COM_RATE_LIMIT_PER_HOUR=2000
# QURAN_COM_RATE_LIMIT_PER_DAY=20000

# =============================================================================
# CACHE CONFIGURATION (OPTIONAL OVERRIDES)
# =============================================================================
# These override the cache TTL values in the YAML config
# Format: CACHE_CATEGORY_TTL (e.g., 30d, 24h, 60m)

# Example: Override Quran text cache TTL
# CACHE_QURAN_TEXT_TTL=60d
# CACHE_HADITH_TTL=60d
# CACHE_PRAYER_TIMES_TTL=2d

# =============================================================================
# HEALTH MONITORING (OPTIONAL OVERRIDES)
# =============================================================================

# Health check interval (default: 5m)
# HEALTH_CHECK_INTERVAL=5m

# Consecutive failures before marking API unhealthy (default: 3)
# UNHEALTHY_THRESHOLD=3

# Consecutive successes before marking API healthy (default: 2)
# RECOVERY_THRESHOLD=2

# =============================================================================
# RETRY CONFIGURATION (OPTIONAL OVERRIDES)
# =============================================================================

# Maximum retry attempts for failed requests (default: 3)
# MAX_RETRY_ATTEMPTS=3

# Initial retry delay (default: 1s)
# RETRY_INITIAL_DELAY=1s

# Maximum retry delay (default: 10s)
# RETRY_MAX_DELAY=10s

# Retry backoff multiplier (default: 2.0)
# RETRY_MULTIPLIER=2.0

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. API Key Security:
#    - NEVER commit .env file to version control
#    - Use secrets manager in production (AWS Secrets Manager, HashiCorp Vault, etc.)
#    - Rotate API keys regularly
#    - Use different keys for development, staging, and production
#
# 2. Required API Keys:
#    - SUNNAH_COM_API_KEY: Required for hadith functionality
#    - HUGGING_FACE_API_KEY: Required for AI/NLP features
#    - All other keys are optional but recommended for redundancy
#
# 3. Rate Limits:
#    - Respect each API's terms of service
#    - Configure rate limits conservatively to avoid bans
#    - Monitor rate limit usage via metrics endpoint
#
# 4. Caching:
#    - Static data (Quran, Hadith) uses long TTL (30 days)
#    - Dynamic data (Prayer times) uses short TTL (1 day)
#    - Stale cache is used as fallback when APIs fail
#
# 5. Health Monitoring:
#    - APIs are checked every 5 minutes by default
#    - Unhealthy APIs are automatically bypassed
#    - Recovery is detected automatically
#
# 6. For Production:
#    - Set ENVIRONMENT=production
#    - Enable JSON_LOGGING=true
#    - Configure OTEL_EXPORTER_OTLP_ENDPOINT for tracing
#    - Set up SENTRY_DSN for error tracking
#    - Use strong database passwords
#    - Enable TLS for Redis and PostgreSQL connections
#
# =============================================================================
