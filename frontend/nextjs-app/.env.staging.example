# Staging Environment Variables for Next.js App

# API Configuration
NEXT_PUBLIC_API_URL=https://staging-api.sanad.app
NEXT_PUBLIC_APP_ENV=staging

# Analytics
NEXT_PUBLIC_GA_ID=G-STAGING-XXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your_staging_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_staging_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_staging_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_staging_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_staging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_staging_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-STAGING-XXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=true
NEXT_PUBLIC_ENABLE_RECITATION_ANALYSIS=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=true
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true

# App Configuration
NEXT_PUBLIC_APP_VERSION=1.0.0-staging
NEXT_PUBLIC_MAX_UPLOAD_SIZE=52428800
NEXT_PUBLIC_SUPPORTED_LANGUAGES=ar,en,fr,ur

# Security
NEXT_PUBLIC_ENABLE_HTTPS_ONLY=true
NEXT_PUBLIC_ENABLE_CERTIFICATE_PINNING=false
